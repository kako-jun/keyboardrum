{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keyboardrum",
  "version": "0.1.0",
  "identifier": "com.kakojun.keyboardrum",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "keyboardrum",
        "width": 460,
        "height": 360,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
